    containers >=0.7 && <0.8,
    diagnostics,
    directory >=1.3.9 && <1.4,
    filepath >=1.5.4 && <1.6,
    lambline >=0.1 && <0.2,
    parser-combinators >=1.3.0 && <1.4,
    process >=1.6 && <1.7,
    text >=2.1.2 && <2.2,
    vector >=0.13.2 && <0.14,
    viewer,

  default-extensions:
    DataKinds
    DeriveFoldable
    DeriveFunctor
    DeriveTraversable
    DisambiguateRecordFields
    EmptyCase
    GADTs
    LambdaCase
    MonoLocalBinds
    MultilineStrings
    MultiWayIf
    NamedFieldPuns
    PolymorphicComponents
    PostfixOperators
    ScopedTypeVariables
    StandaloneKindSignatures
    TypeOperators

  hs-source-dirs:
