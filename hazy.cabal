cabal-version: 2.4
name: hazy
version: 0.1.0.0
synopsis: The Hazy Haskell Compiler
description:
homepage:
license: GPL-3.0-only
license-file: LICENSE
author: Freddy Angel Cubas "superstar64"
maintainer: Hexagonalstar64@gmail.com
copyright: Copyright © 2026 Freddy Angel Cubas "superstar64"
category: Development

library diagnostics
  exposed-modules:
    Diagnostics

  build-depends:
    base,
    containers >=0.7 && <0.8,
    diagnose >=2.5 && <2.6,
    prettyprinter >=1.7 && <1.8,
    text >=2.1.2 && <2.2,

  default-extensions:
    LambdaCase
    NamedFieldPuns

  hs-source-dirs:
    diagnostics

  -- The C library of Windows lacks a function that diagnose uses.
  if os(windows)
    c-sources:
      diagnostics/wcwidth.c

  default-language: Haskell2010

library viewer
  exposed-modules:
    Viewer

  build-depends:
    base,
    brick >=2.9 && <2.11,
    containers >=0.7 && <0.8,
    text >=2.1.2 && <2.2,
    vty >=6.2 && <6.6,

  default-extensions:
    LambdaCase
    NamedFieldPuns

  hs-source-dirs:
    viewer

  default-language: Haskell2010

